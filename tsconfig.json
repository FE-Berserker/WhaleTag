{
  "compilerOptions": {
    "target": "es2022",
    "module": "CommonJS",
    "lib": ["dom", "dom.iterable", "es2022"],
    "jsx": "react-jsx",
    "sourceMap": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "strict": true,
    "noUnusedLocals": false,
    // Zero-cost hardening (the code base already passes): every code path of a
    // value-returning function must return, no case may fall through,
    // imports must use the real casing of the file on disk, and an overriding
    // method must say so (catches a renamed base method that silently stops
    // being overridden).
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "pretty": true,
    "baseUrl": "./",
    "paths": {
      "-/*": ["src/renderer/*"]
    },
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts"],
  "exclude": ["node_modules", "release/build", "release/app/dist", ".erb/dll"]
}
