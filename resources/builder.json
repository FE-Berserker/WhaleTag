{
  "appId": "org.whaletag.app",
  "productName": "WhaleTag",
  "copyright": "Copyright © WhaleTag",
  "directories": {
    "app": "release/app",
    "output": "release/build",
    "buildResources": "resources"
  },
  "icon": "resources/icon.ico",
  "files": [
    "dist/**/*",
    "package.json",
    "!**/node_modules/**/*",
    "**/node_modules/better-sqlite3/{package.json,LICENSE,lib/**,build/Release/*.node}",
    "**/node_modules/bindings/{package.json,LICENSE.md,bindings.js}",
    "**/node_modules/file-uri-to-path/{package.json,LICENSE,index.js}",
    "**/node_modules/ffmpeg-static/{package.json,index.js,LICENSE,ffmpeg,ffmpeg.exe,ffmpeg.exe.LICENSE}",
    "**/node_modules/iconv-lite/{package.json,LICENSE,lib/**,encodings/**}",
    "**/node_modules/safer-buffer/{package.json,LICENSE,safer.js,dangerous.js}",
    "**/node_modules/exifr/{package.json,LICENSE,dist/full.umd.js}",
    "**/node_modules/jschardet/{package.json,LICENSE,index.js,src/**}",
    "**/node_modules/semver/{package.json,LICENSE,index.js,preload.js,classes/**,functions/**,internal/**,ranges/**}",
    "**/node_modules/detect-libc/{package.json,LICENSE,lib/**}",
    "**/node_modules/sharp/{package.json,LICENSE,dist/**,lib/**,src/**}",
    "**/node_modules/@img/**/*",
    "**/node_modules/@napi-rs/**/*",
    "**/node_modules/pdfjs-dist/{package.json,LICENSE,legacy/build/pdf.mjs,legacy/build/pdf.worker.mjs,cmaps/**,standard_fonts/**,wasm/**,iccs/**}",
    "!**/node_modules/*/node_modules/**"
  ],
  "electronLanguages": [
    "en-US",
    "zh-CN",
    "zh-TW",
    "ja",
    "ko"
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/sharp/**/*",
    "**/node_modules/@img/**/*",
    "**/node_modules/better-sqlite3/**/*",
    "**/node_modules/ffmpeg-static/**/*",
    "**/node_modules/@napi-rs/**/*",
    "**/node_modules/pdfjs-dist/cmaps/**/*",
    "**/node_modules/pdfjs-dist/standard_fonts/**/*",
    "**/node_modules/pdfjs-dist/wasm/**/*"
  ],
  "mac": {
    "category": "public.app-category.utilities",
    "target": ["dmg"]
  },
  "win": {
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "electronDist": "node_modules/electron/dist",
  "linux": {
    "target": ["AppImage"],
    "category": "Utility"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "FE-Berserker",
      "repo": "WhaleTag",
      "releaseType": "release"
    }
  ]
}
